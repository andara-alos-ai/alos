{
  "workflow_id": "FLOW-005",
  "name": "Rekrutmen",
  "purpose": "Memproses kebutuhan rekrutmen sampai review kandidat manusia dan persiapan berkas onboarding.",
  "version": "0.3.0",
  "status": "STAGED",
  "owner": "Kepala HR",
  "trigger": ["Recruitment Request diajukan"],
  "agents": ["SEA", "HRA", "HPA"],
  "initial_step": "request-submitted",
  "terminal_steps": ["onboarding-checklist", "request-closed", "exception-open"],
  "steps": [
    {"step_id": "request-submitted", "name": "Kebutuhan diajukan", "actor_type": "human", "actor_ref": "Division Requester", "deterministic": true, "requires_evidence": true},
    {"step_id": "sop-plan", "name": "Rencana SOP rekrutmen", "actor_type": "agent", "actor_ref": "SEA", "deterministic": true, "invocations": [{"agent_id": "SEA", "capability": "compose_work_plan", "execution_mode": "DETERMINISTIC", "tools": ["alos.sop.read"]}]},
    {"step_id": "candidate-screening", "name": "Screening administratif", "actor_type": "agent", "actor_ref": "HRA", "deterministic": false, "invocations": [{"agent_id": "HRA", "capability": "screen_administrative_requirements", "execution_mode": "AI_ASSISTED", "tools": ["alos.hr.restricted_read", "ai.document.analyze"], "requires_human_review": true}]},
    {"step_id": "hr-review", "name": "Review dan keputusan HR", "actor_type": "human", "actor_ref": "HR Human", "deterministic": true, "requires_human_decision": true},
    {"step_id": "onboarding-checklist", "name": "Checklist berkas awal", "actor_type": "agent", "actor_ref": "HPA", "deterministic": true, "invocations": [{"agent_id": "HPA", "capability": "check_personnel_file_completeness", "execution_mode": "DETERMINISTIC", "tools": ["alos.hr.restricted_read"]}]},
    {"step_id": "request-closed", "name": "Permintaan ditutup", "actor_type": "system", "actor_ref": "hr-domain", "deterministic": true},
    {"step_id": "exception-open", "name": "Exception dibuka", "actor_type": "system", "actor_ref": "governance", "deterministic": true}
  ],
  "transitions": [
    {"from_step": "request-submitted", "outcome": "valid", "to_step": "sop-plan"},
    {"from_step": "request-submitted", "outcome": "invalid", "to_step": "exception-open"},
    {"from_step": "sop-plan", "outcome": "ready", "to_step": "candidate-screening"},
    {"from_step": "candidate-screening", "outcome": "ready_for_review", "to_step": "hr-review"},
    {"from_step": "hr-review", "outcome": "selected", "to_step": "onboarding-checklist"},
    {"from_step": "hr-review", "outcome": "rejected", "to_step": "request-closed"}
  ]
}
