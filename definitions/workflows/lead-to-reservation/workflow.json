{
  "workflow_id": "FLOW-001",
  "name": "Lead ke Reservasi",
  "purpose": "Mencatat, menugaskan, menindaklanjuti, dan memproses lead sampai hasil pipeline yang sah.",
  "version": "0.1.0",
  "status": "STAGED",
  "owner": "Kepala Sales & Marketing",
  "trigger": ["Formulir lead internal", "Impor data sintetis"],
  "agents": ["SLA", "CFA"],
  "initial_step": "lead-received",
  "terminal_steps": ["pipeline-result", "exception-open"],
  "steps": [
    {"step_id": "lead-received", "name": "Lead diterima", "actor_type": "system", "actor_ref": "workflow-engine", "deterministic": true},
    {"step_id": "lead-validation", "name": "Validasi dan deduplikasi", "actor_type": "agent", "actor_ref": "SLA", "deterministic": true, "requires_evidence": true},
    {"step_id": "sales-assignment", "name": "Penugasan Sales PIC", "actor_type": "human", "actor_ref": "Sales Human", "deterministic": true},
    {"step_id": "follow-up-plan", "name": "Rencana tindak lanjut", "actor_type": "agent", "actor_ref": "CFA", "deterministic": false},
    {"step_id": "interaction-review", "name": "Interaksi dan hasil", "actor_type": "human", "actor_ref": "Sales Human", "deterministic": true, "requires_human_decision": true},
    {"step_id": "pipeline-result", "name": "Pipeline atau reservasi tercatat", "actor_type": "system", "actor_ref": "sales-domain", "deterministic": true},
    {"step_id": "exception-open", "name": "Exception dibuka", "actor_type": "system", "actor_ref": "governance", "deterministic": true}
  ],
  "transitions": [
    {"from_step": "lead-received", "outcome": "submitted", "to_step": "lead-validation"},
    {"from_step": "lead-validation", "outcome": "valid", "to_step": "sales-assignment"},
    {"from_step": "lead-validation", "outcome": "invalid", "to_step": "exception-open"},
    {"from_step": "sales-assignment", "outcome": "assigned", "to_step": "follow-up-plan"},
    {"from_step": "follow-up-plan", "outcome": "ready", "to_step": "interaction-review"},
    {"from_step": "interaction-review", "outcome": "qualified", "to_step": "pipeline-result"},
    {"from_step": "interaction-review", "outcome": "follow_up", "to_step": "follow-up-plan"},
    {"from_step": "interaction-review", "outcome": "exception", "to_step": "exception-open"}
  ]
}
