{
  "schema_version": "1.0.0",
  "profiles": {
    "executive.aggregate.v1": {
      "input_properties": {"verified_facts":{"type":"array","items":{"type":"object","additionalProperties":true}},"source_references":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true}},
      "input_required": ["verified_facts", "source_references"],
      "output_properties": {"fact_count":{"type":"integer"},"source_count":{"type":"integer"},"facts_digest":{"type":"string"},"ready":{"type":"boolean"}},
      "output_required": ["fact_count", "source_count", "facts_digest", "ready"]
    },
    "evidence.metadata.v1": {
      "input_properties": {"checksum_valid":{"type":"boolean"},"scan_status":{"type":"string","enum":["NOT_CONFIGURED","CLEAN","PENDING","INFECTED","REJECTED","ERROR","FAILED"]}},
      "input_required": ["checksum_valid", "scan_status"],
      "output_properties": {"valid":{"type":"boolean"},"checksum_valid":{"type":"boolean"},"scan_status":{"type":"string"}},
      "output_required": ["valid", "checksum_valid", "scan_status"]
    },
    "risk.deadline.v1": {
      "input_properties": {"due_dates":{"type":"array","items":{"type":"string"}},"evaluated_at":{"type":"string"}},
      "input_required": ["due_dates"],
      "output_properties": {"evaluated_at":{"type":"string"},"total_count":{"type":"integer"},"overdue_count":{"type":"integer"},"next_due_at":{"type":["string","null"]}},
      "output_required": ["evaluated_at", "total_count", "overdue_count", "next_due_at"]
    }
  }
}
