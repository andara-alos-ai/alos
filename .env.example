ALOS_ENVIRONMENT=local
ALOS_LOG_LEVEL=INFO
ALOS_API_HOST=0.0.0.0
ALOS_API_PORT=8000
ALOS_WEB_ORIGIN=http://localhost:3000
ALOS_POSTGRES_PORT=5433
ALOS_DATABASE_URL=postgresql+psycopg://alos:change-me@localhost:5433/alos
ALOS_AUTH_ISSUER=alos-local
ALOS_AUTH_AUDIENCE=alos-internal
ALOS_AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
ALOS_AUTH_TOKEN_TTL_SECONDS=3600
ALOS_OBJECT_STORAGE_PROVIDER=filesystem
ALOS_OBJECT_STORAGE_BUCKET=alos-documents
ALOS_OBJECT_STORAGE_PATH=./data/objects
ALOS_OBJECT_STORAGE_ENDPOINT_URL=
ALOS_OBJECT_STORAGE_REGION=us-east-1
ALOS_OBJECT_STORAGE_ACCESS_KEY=
ALOS_OBJECT_STORAGE_SECRET_KEY=
ALOS_OBJECT_STORAGE_MAX_UPLOAD_BYTES=26214400
ALOS_DOCUMENT_SCAN_MODE=disabled
ALOS_WORKER_POLL_SECONDS=5
ALOS_WORKER_BATCH_SIZE=50
ALOS_WORKER_LEASE_SECONDS=120
ALOS_WORKER_MAX_ATTEMPTS=5
ALOS_DEADLINE_HORIZON_MINUTES=1440
ALOS_ESCALATION_INTERVAL_MINUTES=60
ALOS_N8N_ENABLED=false
ALOS_N8N_WEBHOOK_URL=
ALOS_N8N_WEBHOOK_SECRET=
ALOS_N8N_TIMEOUT_SECONDS=10
ALOS_LLM_PROVIDER=disabled
ALOS_LLM_API_KEY=
NEXT_PUBLIC_ALOS_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ALOS_PILOT_LOGIN_ENABLED=true
