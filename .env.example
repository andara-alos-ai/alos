# ALOS — Andara Leaverage Operating Sistem. Local bootstrap only; never commit a real secret.
ALOS_ENVIRONMENT=local
ALOS_APPLICATION_NAME=ALOS
ALOS_LOG_LEVEL=INFO
ALOS_API_HOST=0.0.0.0
ALOS_API_PORT=8000
ALOS_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ALOS_API_URL=http://localhost:8000/api/v1

# One shared local PostgreSQL database. Use a local-only password.
ALOS_POSTGRES_PORT=5433
ALOS_POSTGRES_PASSWORD=replace-with-local-password
ALOS_DATABASE_URL=postgresql+psycopg://alos:replace-with-local-password@127.0.0.1:5433/alos

# Replace before any environment other than local development.
ALOS_AUTH_ISSUER=alos-local
ALOS_AUTH_AUDIENCE=alos-platform
ALOS_AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
ALOS_AUTH_TOKEN_TTL_SECONDS=3600

# Filesystem storage is local/test only. Staging/production must use S3 or R2.
ALOS_OBJECT_STORAGE_PROVIDER=filesystem
ALOS_OBJECT_STORAGE_BUCKET=alos-documents
ALOS_OBJECT_STORAGE_PATH=./data/objects
ALOS_OBJECT_STORAGE_MAX_UPLOAD_BYTES=26214400
ALOS_OBJECT_STORAGE_ENDPOINT_URL=
ALOS_OBJECT_STORAGE_REGION=auto
ALOS_OBJECT_STORAGE_ACCESS_KEY_ID=
ALOS_OBJECT_STORAGE_SECRET_ACCESS_KEY=
ALOS_OBJECT_STORAGE_FORCE_PATH_STYLE=false
ALOS_OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256

# Model Gateway. Keep disabled until a server-side provider key is set.
# Gemini is local/test-only. For staging/production, use the OpenAI provider.
# Never put this key in frontend code, images, logs, or the repository.
# Optional route overrides map Agent Contract routes deterministically:
# light (high-volume), standard (analysis), critical (high-stakes review).
ALOS_LLM_PROVIDER=disabled
ALOS_LLM_API_KEY=
ALOS_LLM_MODEL=
ALOS_LLM_MODEL_LIGHT=
ALOS_LLM_MODEL_STANDARD=
ALOS_LLM_MODEL_CRITICAL=
ALOS_LLM_BASE_URL=
ALOS_LLM_FALLBACK_PROVIDER=disabled
ALOS_LLM_FALLBACK_API_KEY=
ALOS_LLM_FALLBACK_MODEL=
ALOS_LLM_FALLBACK_BASE_URL=
ALOS_LLM_TIMEOUT_SECONDS=60
ALOS_LLM_STORE_RESPONSES=false
ALOS_LLM_REASONING_EFFORT=medium
ALOS_LLM_MAX_OUTPUT_TOKENS=3000
ALOS_LLM_MAX_CONTEXT_TOKENS=12000
ALOS_LLM_MAX_DATA_CLASSIFICATION=INTERNAL
ALOS_LLM_DAILY_REQUEST_LIMIT=500
ALOS_LLM_DAILY_OUTPUT_TOKEN_LIMIT=500000
ALOS_LLM_DAILY_COST_CAP_USD=5.00
ALOS_LLM_MAX_RETRIES=1
ALOS_GENESIS_SEMANTIC_ANALYSIS_ENABLED=false
ALOS_GENESIS_SEMANTIC_MAX_OUTPUT_TOKENS=1200
ALOS_GENESIS_CONVERSATION_FOLLOW_UP_ENABLED=false
ALOS_GENESIS_FOLLOW_UP_MAX_OUTPUT_TOKENS=1200
ALOS_SOURCE_CHUNK_MAX_CHARS=1500
ALOS_SOURCE_RETRIEVAL_MAX_CHARS=10000
ALOS_BUDGET_TIMEZONE=Asia/Jakarta
