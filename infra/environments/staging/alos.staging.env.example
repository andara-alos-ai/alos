# Copy outside the repository, for example to /etc/alos/alos.staging.env.
# This is an example only. Never commit the copied file or a real secret.

ALOS_PUBLIC_HOST=alos-staging.example.com
ALOS_TLS_EMAIL=admin@example.com
ALOS_LOG_LEVEL=INFO

# Generate with: openssl rand -hex 24
ALOS_POSTGRES_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS

# Generate with: openssl rand -hex 32
ALOS_AUTH_SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ALOS_AUTH_TOKEN_TTL_SECONDS=3600

# Set this value directly on the VPS. Do not send it in chat or commit it.
ALOS_LLM_PROVIDER=openai
ALOS_LLM_API_KEY=SET_ON_VPS_ONLY
# ALOS resolves Contract routes on the server only. Do not put raw model names
# in Agent Contracts.
ALOS_LLM_MODEL=gpt-5.6-luna
ALOS_LLM_MODEL_LIGHT=gpt-5.6-luna
ALOS_LLM_MODEL_STANDARD=gpt-5.6-terra
ALOS_LLM_MODEL_CRITICAL=gpt-5.6-sol
ALOS_LLM_BASE_URL=
ALOS_LLM_FALLBACK_PROVIDER=disabled
ALOS_LLM_FALLBACK_API_KEY=
ALOS_LLM_FALLBACK_MODEL=
ALOS_LLM_FALLBACK_BASE_URL=
ALOS_LLM_TIMEOUT_SECONDS=60
ALOS_LLM_STORE_RESPONSES=false
ALOS_LLM_REASONING_EFFORT=medium
ALOS_LLM_MAX_OUTPUT_TOKENS=1200
ALOS_LLM_MAX_DATA_CLASSIFICATION=INTERNAL
ALOS_LLM_DAILY_REQUEST_LIMIT=2
ALOS_LLM_DAILY_OUTPUT_TOKEN_LIMIT=2400
ALOS_LLM_DAILY_COST_CAP_USD=5.00
