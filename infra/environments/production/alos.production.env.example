# Copy to /etc/alos/alos.production.env on the VPS. Owner root:alos, mode 0640.
# Do not commit the copied file or replace these placeholders in Git.

ALOS_ENVIRONMENT=production
ALOS_PUBLIC_HOST=alos.example.com
ALOS_TLS_EMAIL=admin@example.com
ALOS_WEB_ORIGIN=https://alos.example.com
ALOS_LOG_LEVEL=INFO
ALOS_DATABASE_URL=postgresql+psycopg://alos:SET_ON_VPS_ONLY@managed-postgres.example:5432/alos?sslmode=require
ALOS_AUTH_ISSUER=alos-production
ALOS_AUTH_AUDIENCE=alos-platform
ALOS_AUTH_SIGNING_SECRET=SET_ON_VPS_ONLY
ALOS_OBJECT_STORAGE_PROVIDER=s3
ALOS_OBJECT_STORAGE_BUCKET=alos-production-documents
ALOS_OBJECT_STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
ALOS_OBJECT_STORAGE_REGION=auto
ALOS_OBJECT_STORAGE_ACCESS_KEY_ID=SET_ON_VPS_ONLY
ALOS_OBJECT_STORAGE_SECRET_ACCESS_KEY=SET_ON_VPS_ONLY
ALOS_OBJECT_STORAGE_FORCE_PATH_STYLE=false
ALOS_OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
ALOS_OBJECT_STORAGE_MAX_UPLOAD_BYTES=26214400
ALOS_MIGRATIONS_PATH=/opt/alos/infra/database
ALOS_LLM_PROVIDER=disabled
ALOS_LLM_STORE_RESPONSES=false
