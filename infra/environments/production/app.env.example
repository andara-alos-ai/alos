ALOS_ENVIRONMENT=production
ALOS_POSTGRES_PASSWORD=inject-from-secret-manager
ALOS_AUTH_SIGNING_SECRET=inject-from-secret-manager
ALOS_AUTH_ISSUER=alos-production
ALOS_AUTH_AUDIENCE=alos-internal
ALOS_WEB_ORIGIN=https://alos.example.internal
ALOS_OIDC_PROVIDER=google
ALOS_OIDC_CLIENT_ID=inject-from-secret-manager
ALOS_OIDC_CLIENT_SECRET=inject-from-secret-manager
ALOS_OIDC_REDIRECT_URI=https://alos-api.example.internal/api/v1/auth/oidc/callback/google
ALOS_OIDC_ALLOWED_DOMAIN=example.internal
ALOS_DOCUMENT_SCAN_MODE=external
ALOS_OBJECT_STORAGE_PROVIDER=s3
ALOS_OBJECT_STORAGE_BUCKET=alos-production-documents
ALOS_OBJECT_STORAGE_ENDPOINT_URL=https://s3.example.internal
ALOS_OBJECT_STORAGE_REGION=ap-southeast-3
ALOS_OBJECT_STORAGE_ACCESS_KEY=inject-from-secret-manager
ALOS_OBJECT_STORAGE_SECRET_KEY=inject-from-secret-manager
ALOS_LLM_PROVIDER=disabled
ALOS_LLM_API_KEY=inject-from-secret-manager-when-enabled
ALOS_LLM_MODEL=
ALOS_LLM_BASE_URL=
ALOS_LLM_MAX_DATA_CLASSIFICATION=INTERNAL
ALOS_N8N_ENABLED=false
ALOS_N8N_WEBHOOK_URL=
ALOS_N8N_WEBHOOK_SECRET=inject-from-secret-manager-when-enabled
NEXT_PUBLIC_ALOS_API_URL=https://alos-api.example.internal/api/v1
NEXT_PUBLIC_ALOS_PILOT_LOGIN_ENABLED=false
